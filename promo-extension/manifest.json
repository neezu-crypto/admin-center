{
  "manifest_version": 3,
  "name": "SOOP 홍보글·게시판 찾기",
  "version": "0.9.1",
  "description": "SOOP 방송국에서 홍보 후보 게시판과 글쓰기 링크를 찾고 관리자 센터의 홍보글 작성을 보조합니다.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://neezu-crypto.github.io/admin-center/*",
    "https://sooplive.com/station/*",
    "https://www.sooplive.com/station/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://neezu-crypto.github.io/admin-center/*"],
      "js": ["admin-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sooplive.com/station/*",
        "https://www.sooplive.com/station/*"
      ],
      "js": ["station-board-finder.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sooplive.com/station/*/post/*",
        "https://www.sooplive.com/station/*/post/*"
      ],
      "js": ["soop-writer.js"],
      "run_at": "document_idle"
    }
  ]
}
